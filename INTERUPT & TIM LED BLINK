#include <stdint.h>

#define RCC_BASE_ADD   0x40023800
#define GPIOA_BASE_ADD 0x40020000
#define GPIOC_BASE_ADD 0x40020800
#define TIM2_BASE_ADD  0x40000000
#define SYSCFG_BASE_ADD 0x40013800
#define EXTI_BASE_ADD   0x40013C00
#define NVIC_ISER1     (*(volatile uint32_t*)0xE000E104)

#define RCC_AHB1ENR (*(volatile uint32_t*)(RCC_BASE_ADD + 0x30))
#define RCC_APB1ENR (*(volatile uint32_t*)(RCC_BASE_ADD + 0x40))
#define RCC_APB2ENR (*(volatile uint32_t*)(RCC_BASE_ADD + 0x44))

#define GPIOA_MODER (*(volatile uint32_t*)(GPIOA_BASE_ADD + 0x00))
#define GPIOA_OTYPER (*(volatile uint32_t*)(GPIOA_BASE_ADD + 0x04))
#define GPIOA_ODR (*(volatile uint32_t*)(GPIOA_BASE_ADD + 0x14))

#define GPIOC_MODER (*(volatile uint32_t*)(GPIOC_BASE_ADD + 0x00))

#define SYSCFG_EXTICR4 (*(volatile uint32_t*)(SYSCFG_BASE_ADD + 0x14))

#define EXTI_IMR  (*(volatile uint32_t*)(EXTI_BASE_ADD + 0x00))
#define EXTI_FTSR (*(volatile uint32_t*)(EXTI_BASE_ADD + 0x0C))
#define EXTI_PR   (*(volatile uint32_t*)(EXTI_BASE_ADD + 0x14))

#define TIM2_CR1 (*(volatile uint32_t*)(TIM2_BASE_ADD + 0x00))
#define TIM2_PSC (*(volatile uint32_t*)(TIM2_BASE_ADD + 0x28))
#define TIM2_ARR (*(volatile uint32_t*)(TIM2_BASE_ADD + 0x2C))
#define TIM2_SR  (*(volatile uint32_t*)(TIM2_BASE_ADD + 0x10))

void EXTI15_10_IRQHandler(void);

int main()
{ RCC_AHB1ENR |= (1<<0);    
    RCC_AHB1ENR |= (1<<2);    
    RCC_APB2ENR |= (1<<14);   

    GPIOA_MODER &= ~(3<<10);
    GPIOA_MODER |= (1<<10);
    GPIOA_OTYPER &= ~(1<<5);
    GPIOC_MODER &= ~(3<<26);

    SYSCFG_EXTICR4 &= ~(0xF<<4);
    SYSCFG_EXTICR4 |=  (0x2<<4);

    EXTI_IMR |= (1<<13);
    EXTI_FTSR |= (1<<13);
    NVIC_ISER1 |= (1<<8);

    while(1)
    {

    }
}

void EXTI15_10_IRQHandler(void)
{
    if(EXTI_PR & (1<<13))
    {
        GPIOA_ODR ^= (1<<5);  
        EXTI_PR |= (1<<13);    
    }
}
